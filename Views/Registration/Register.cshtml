@{
    ViewData["Title"] = "Student Registration page";
}
<h2>Studejnt Registration</h2>
<form action="/Registration/Register" method="post">
    @Html.ValidationSummary()

    <div>
        <label for="StudentId">Student Id</label>
        <input type="text" name="StudentId" id="StudentId" />
        @Html.ValidationMessage("StudentId")
    </div>

    <div>
        <label for=Name>Full Name</label>
        <input type="text" name="Name" id="Name" />
        @Html.ValidationMessage("Name")
     </div>

     <div>
         <label for="Email">Email</label>
         <input type="email" name="Email" id="Email" />
         @Html.ValidationMessage("Email")
     </div>

    <div>
        <label for="Age">Age</label>
        <input type="number" name="Age" id="Age" />
        @Html.ValidationMessage("Age")
    </div>
    <div>
        <label for="CGPA">CGPA</label>
        <input type="number" name="CGPA" id="CGPA" step="0.01" min="0" max="4" />
        @Html.ValidationMessage("CGPA")
    </div>

    <div>
        <label for="DateOfBirth">Date of Birth</label>
        <input type="date" name="DateOfBirth" id="DateOfBirth" />
        @Html.ValidationMessage("DateOfBirth")
    </div>
    <div>
        <button type="submit">Register</button>
    </div>



</form>