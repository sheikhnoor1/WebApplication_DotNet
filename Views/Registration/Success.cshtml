@{
    ViewData["Title"] = "Student Registration Successful";
}
<h2> Student Registration Successful</h2>
<table border="1" cellpadding="6" cellpadding="0">
    <tr>
        <th>Field</th>
        <th>Value</th>
    </tr>
    <tr>
        <td>Student Id</td>
        <td>@Model.StudentId</td>
    </tr>
   <tr>
        <td>Name</td>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <td>Age</td>
        <td>@Model.Age</td>
    </tr>
    <tr>
        <td>CGPA</td>
        <td>@Model.CGPA</td>
    </tr>
</table>
<br />
<a href="/Registration/Register">Register Another Student</a>

</table>
